{
  "logging": {
    "level": "debug",
    "categories": {
      "mcp": "info",
      "mcp.transport": "debug",
      "mcp.auth": "warn"
    },
    "outputs": [
      { "type": "console" },
      {
        "type": "file",
        "path": "logs/kachinco.log",
        "format": "text",
        "rotation": {
          "enabled": true,
          "maxFileSizeMb": 20,
          "maxFiles": 10
        }
      }
    ]
  }
}
