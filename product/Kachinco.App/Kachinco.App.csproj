<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <OutputType>WinExe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Kachinco.Core/Kachinco.Core.csproj" />
    <ProjectReference Include="../Kachinco.Infrastructure/Kachinco.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Flamoris.Mcp.Wpf" Version="1.2.0" Condition="'$(FlamorisMcpSourceRoot)' == ''" />
    <ProjectReference Include="$(FlamorisMcpSourceRoot)/src/Flamoris.Mcp.Wpf/Flamoris.Mcp.Wpf.csproj" Condition="'$(FlamorisMcpSourceRoot)' != ''" />
  </ItemGroup>
</Project>
