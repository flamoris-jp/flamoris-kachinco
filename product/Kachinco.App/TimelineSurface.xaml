<UserControl x:Class="Kachinco.App.TimelineSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#20242B">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="30" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="104" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Border Grid.Row="0" Grid.Column="0" Background="#303640" BorderBrush="#505761" BorderThickness="0,0,1,1">
      <TextBlock Text="トラック" Foreground="#CAD0D8" VerticalAlignment="Center" Margin="10,0" />
    </Border>
    <ScrollViewer x:Name="RulerScroll" Grid.Row="0" Grid.Column="1"
                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                  IsHitTestVisible="True">
      <Canvas x:Name="RulerCanvas" Height="30" Background="#303640"
              PreviewMouseLeftButtonDown="Ruler_MouseLeftButtonDown" />
    </ScrollViewer>
    <ScrollViewer x:Name="HeaderScroll" Grid.Row="1" Grid.Column="0"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
      <StackPanel x:Name="TrackHeaders" Background="#292E36" />
    </ScrollViewer>
    <ScrollViewer x:Name="TimelineScroll" Grid.Row="1" Grid.Column="1"
                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                  CanContentScroll="False" ScrollChanged="TimelineScroll_ScrollChanged">
      <Canvas x:Name="TimelineCanvas" Background="#20242B"
              PreviewMouseLeftButtonDown="Timeline_MouseLeftButtonDown" />
    </ScrollViewer>
  </Grid>
</UserControl>
