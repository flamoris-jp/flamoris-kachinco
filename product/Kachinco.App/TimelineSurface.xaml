<UserControl x:Class="Kachinco.App.TimelineSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#202124" Focusable="True" PreviewKeyDown="TimelineSurface_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="RulerRow" Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Name="RulerHost" Grid.Row="0" Height="30">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="RulerHeaderColumn"/><ColumnDefinition Width="*"/><ColumnDefinition Width="{x:Static SystemParameters.VerticalScrollBarWidth}"/></Grid.ColumnDefinitions>
      <Border Background="#2B2D31" BorderBrush="#484B50" BorderThickness="0,0,1,1">
        <TextBlock Text="{DynamicResource Shell.Track}" Foreground="#E7E7E7" VerticalAlignment="Center" Margin="8,0" />
      </Border>
      <Grid x:Name="RulerViewportHost" Grid.Column="1" ClipToBounds="True" Background="#2B2D31" PreviewMouseLeftButtonDown="Ruler_MouseLeftButtonDown"
            MouseMove="Ruler_MouseMove" MouseLeftButtonUp="Ruler_MouseLeftButtonUp">
        <Canvas x:Name="RulerCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Height="30" Background="#2B2D31">
          <Canvas.RenderTransform><TranslateTransform x:Name="RulerTranslation"/></Canvas.RenderTransform>
        </Canvas>
      </Grid>
    </Grid>
    <!-- One physical vertical scroller. No independent header scroll/clamping. -->
    <ScrollViewer x:Name="TimelineScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Visible" CanContentScroll="False"
                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" Padding="0" BorderThickness="0">
      <Grid VerticalAlignment="Top">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="TrackHeaderColumn"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Canvas x:Name="TrackHeaders" Background="#2B2D31" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
        <Grid x:Name="TimelineViewportHost" Grid.Column="1" ClipToBounds="True" Background="#202124" SizeChanged="Viewport_SizeChanged">
          <Canvas x:Name="TimelineCanvas" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#202124"
                  PreviewMouseLeftButtonDown="Timeline_MouseLeftButtonDown">
            <Canvas.RenderTransform><TranslateTransform x:Name="TimelineTranslation"/></Canvas.RenderTransform>
          </Canvas>
        </Grid>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="ScrollHeaderColumn"/><ColumnDefinition Width="*"/><ColumnDefinition Width="{x:Static SystemParameters.VerticalScrollBarWidth}"/></Grid.ColumnDefinitions>
      <ScrollBar x:Name="HorizontalScroll" Grid.Column="1" Orientation="Horizontal" Minimum="0" ValueChanged="HorizontalScroll_Changed" />
    </Grid>
  </Grid>
</UserControl>
