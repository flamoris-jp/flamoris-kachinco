<Window x:Class="Kachinco.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kachinco.App"
        Title="FLAMORIS Kachinco" Width="1320" Height="820" MinWidth="980" MinHeight="640"
        Background="#F2F3F5" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="ファイル(_F)">
        <MenuItem Header="新規・横長(_L)" Click="NewLandscape_Click" />
        <MenuItem Header="新規・縦長(_P)" Click="NewPortrait_Click" />
        <Separator />
        <MenuItem Header="開く(_O)…" Click="Open_Click" InputGestureText="Ctrl+O" />
        <MenuItem Header="名前を付けて保存(_A)…" Click="Save_Click" InputGestureText="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="素材を読み込む(_I)…" Click="Register_Click" />
        <MenuItem Header="動画を書き出す…" Click="Export_Click" />
      </MenuItem>
      <MenuItem Header="字幕(_T)">
        <MenuItem Header="字幕を編集…" Click="EditCaptions_Click" />
        <MenuItem Header="SRTを読み込む…" Click="ImportSrt_Click" />
        <MenuItem Header="SRTを書き出す…" Click="ExportSrt_Click" />
      </MenuItem>
      <MenuItem Header="編集(_E)">
        <MenuItem x:Name="UndoMenuItem" Header="元に戻す(_U)" Click="Undo_Click" InputGestureText="Ctrl+Z" />
        <MenuItem x:Name="RedoMenuItem" Header="やり直す(_R)" Click="Redo_Click" InputGestureText="Ctrl+Y" />
      </MenuItem>
      <MenuItem Header="クリップ(_C)">
        <MenuItem Header="再生ヘッド位置で分割(_S)" Click="Split_Click" />
        <MenuItem Header="選択クリップを複製" Click="Duplicate_Click" />
        <MenuItem Header="選択クリップを削除(_D)" Click="Delete_Click" InputGestureText="Delete" />
      </MenuItem>
      <MenuItem Header="シーケンス(_S)"><MenuItem Header="映像トラックを追加" Tag="Video" Click="AddTrack_Click" /><MenuItem Header="音声トラックを追加" Tag="Audio" Click="AddTrack_Click" /><MenuItem Header="長さを変更…" Click="SequenceDuration_Click" /></MenuItem>
      <MenuItem Header="表示(_V)">
        <MenuItem x:Name="SnappingMenuItem" Header="スナップ(_N)" IsCheckable="True" IsChecked="True" Click="Snapping_Click" />
        <MenuItem Header="拡大(_I)" Click="ZoomIn_Click" />
        <MenuItem Header="縮小(_O)" Click="ZoomOut_Click" />
      </MenuItem>
      <MenuItem Header="Clapper / Recipe"><MenuItem Header="名前付き範囲とRecipeを編集…" Click="Authoring_Click" /></MenuItem>
      <MenuItem Header="AI接続"><MenuItem Header="MCPを開始 / 停止" Click="Mcp_Click" /></MenuItem>
      <MenuItem Header="ヘルプ(_H)" />
    </Menu>
    <ToolBarTray DockPanel.Dock="Top" Background="#E8E9EC">
      <ToolBar>
        <Button x:Name="UndoButton" Content="↶ 元に戻す" Click="Undo_Click" />
        <Button x:Name="RedoButton" Content="↷ やり直す" Click="Redo_Click" />
        <Separator />
        <Button x:Name="SplitButton" Content="✂ 分割" Click="Split_Click" />
        <Separator />
        <Button Content="プレビュー準備" Click="PreparePreview_Click" />
        <Button Content="|◀" Click="PreviousFrame_Click" ToolTip="前のフレーム" />
        <Button Content="▶ / Ⅱ" Click="Play_Click" ToolTip="再生 / 一時停止" />
        <Button Content="■" Click="Stop_Click" ToolTip="停止" />
        <Button Content="▶|" Click="NextFrame_Click" ToolTip="次のフレーム" />
      </ToolBar>
    </ToolBarTray>
    <Border DockPanel.Dock="Bottom" Background="#E4E6EA" Padding="8,5">
      <TextBlock x:Name="Status" TextWrapping="Wrap" />
    </Border>

    <Grid Margin="10">
      <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="6"/><RowDefinition Height="2.4*"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/><ColumnDefinition Width="280"/>
      </Grid.ColumnDefinitions>

      <Border Background="White" Padding="10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="プロジェクト / 素材" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <WrapPanel>
              <Button Content="MOV / WAV を読み込む" Click="Register_Click" />
              <Button Content="配置" Click="Insert_Click" ToolTip="再生ヘッド位置の互換トラックへ配置" />
            </WrapPanel>
          </StackPanel>
          <ListBox x:Name="MediaList" Margin="0,8,0,0" SelectionChanged="Media_Changed"
                   PreviewMouseLeftButtonDown="Media_MouseDown" PreviewMouseMove="Media_MouseMove" MouseDoubleClick="Media_DoubleClick" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="3">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" Foreground="#68717E" FontSize="11" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{Binding StateBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

      <Border Grid.Column="2" Background="#171B23" Padding="24">
        <Grid>
          <Image x:Name="PreviewImage" Stretch="Uniform" />
          <TextBlock x:Name="PreviewInfo" Foreground="#B7C4D8" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" />

      <Border Grid.Column="4" Background="White" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock Text="インスペクター" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock x:Name="InspectorEmpty" Text="素材またはクリップを選択してください。" Foreground="#68717E" TextWrapping="Wrap" />
            <StackPanel x:Name="AssetInspector" Visibility="Collapsed">
              <TextBlock Text="素材" Foreground="#68717E" />
              <TextBlock x:Name="AssetNameText" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock x:Name="AssetIdText" FontSize="10" Foreground="#68717E" TextWrapping="Wrap" Margin="0,3" />
              <TextBlock x:Name="AssetPathText" TextWrapping="Wrap" Margin="0,4" />
              <TextBlock x:Name="AssetMetadataText" TextWrapping="Wrap" />
              <Button x:Name="RelinkButton" Content="素材を再リンク…" Click="Relink_Click" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel x:Name="ClipInspector" Visibility="Collapsed">
              <TextBlock Text="クリップ" Foreground="#68717E" />
              <TextBlock x:Name="ClipNameText" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock x:Name="ClipIdText" FontSize="10" Foreground="#68717E" TextWrapping="Wrap" Margin="0,3,0,8" />
              <TextBlock Text="開始（秒）" /><TextBox x:Name="ClipStartBox" />
              <TextBlock Text="ソースイン（秒）" Margin="0,6,0,0" /><TextBox x:Name="ClipSourceInBox" />
              <TextBlock Text="長さ（秒）" Margin="0,6,0,0" /><TextBox x:Name="ClipDurationBox" />
              <TextBlock Text="合成" Margin="0,6,0,0" /><ComboBox x:Name="BlendBox" />
              <TextBlock Text="不透明度（0〜1）" /><TextBox x:Name="OpacityBox" />
              <TextBlock Text="位置 X / Y（px）" /><TextBox x:Name="TransformXBox" /><TextBox x:Name="TransformYBox" />
              <TextBlock Text="拡大率 X / Y" /><TextBox x:Name="ScaleXBox" /><TextBox x:Name="ScaleYBox" />
              <TextBlock Text="回転（度）" /><TextBox x:Name="RotationBox" />
              <TextBlock Text="音量（0〜16）" /><TextBox x:Name="GainBox" />
              <CheckBox x:Name="MutedBox" Content="音声をミュート" />
              <CheckBox x:Name="ClipEnabledBox" Content="有効" Margin="0,8,0,0" />
              <Button Content="変更を適用" Click="ApplyInspector_Click" Margin="0,8,0,0" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" Height="6" HorizontalAlignment="Stretch" />
      <Border Grid.Row="2" Grid.ColumnSpan="5" Background="#20242B" BorderBrush="#545B66" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#303640" Padding="8,5">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="タイムライン" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
              <ComboBox x:Name="SequenceList" Width="230" DisplayMemberPath="Name" SelectionChanged="Sequence_Changed" />
        <ToggleButton x:Name="SnappingButton" Content="磁石 スナップ" IsChecked="True" Click="Snapping_Click" />
        <Button Content="−" Click="ZoomOut_Click" ToolTip="タイムラインを縮小" />
        <TextBlock x:Name="ZoomText" VerticalAlignment="Center" MinWidth="62" TextAlignment="Center" />
        <Button Content="＋" Click="ZoomIn_Click" ToolTip="タイムラインを拡大" />
              <Button Content="全体" Click="FitTimeline_Click" ToolTip="シーケンス全体を表示" />
              <TextBlock x:Name="PlayheadText" Foreground="#D5DAE1" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
          </Border>
          <local:TimelineSurface x:Name="Timeline" CommandRequested="Timeline_CommandRequested"
                                 ClipSelectionChanged="Timeline_ClipSelectionChanged" MediaPlacementRequested="Timeline_MediaPlacementRequested" PlayheadChanged="Timeline_PlayheadChanged"
                                 InteractionFailed="Timeline_InteractionFailed" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
