<Window x:Class="Kachinco.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kachinco.App"
        Title="FLAMORIS Kachinco" Width="1320" Height="820" MinWidth="980" MinHeight="640"
        Background="#202124" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Strings.ja.xaml"/></ResourceDictionary.MergedDictionaries>
    <SolidColorBrush x:Key="FamilyAccent" Color="#D20B3A" />
    <Style x:Key="CommandIconButton" TargetType="Button">
      <Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="1"/><Setter Property="Padding" Value="6"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0E6E9"/><Setter Property="BorderBrush" Value="{StaticResource FamilyAccent}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#202124"/><Setter Property="Background" Value="#F6F3F1"/></Style>
    <Style x:Key="InspectorNumber" TargetType="TextBox">
      <Setter Property="Width" Value="96"/><Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Padding" Value="4,2"/><Setter Property="TextAlignment" Value="Right"/>
      <EventSetter Event="PreviewKeyDown" Handler="InspectorNumber_KeyDown"/>
      <EventSetter Event="LostKeyboardFocus" Handler="InspectorNumber_LostFocus"/>
    </Style>
    <Style x:Key="InspectorSection" TargetType="Expander">
      <Setter Property="IsExpanded" Value="True"/><Setter Property="Foreground" Value="#E7E7E7"/>
      <Setter Property="Margin" Value="0,10,0,0"/><Setter Property="Padding" Value="0,5,0,0"/>
    </Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#202124"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#202124"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="2"/></Style>
    <Style x:Key="PanelText" TargetType="TextBlock"><Setter Property="Foreground" Value="#E7E7E7"/></Style>
      </ResourceDictionary>
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem x:Name="FileMenu" Header="{DynamicResource Shell.FileF}">
        <MenuItem x:Name="NewLandscapeMenu" Header="{DynamicResource Shell.NewlandscapeL}" Click="NewLandscape_Click" />
        <MenuItem Header="{DynamicResource Shell.NewportraitP}" Click="NewPortrait_Click" />
        <Separator />
        <MenuItem x:Name="OpenProjectMenu" Header="{DynamicResource Shell.OpenO}" Click="Open_Click" InputGestureText="Ctrl+O" />
        <MenuItem x:Name="SaveProjectMenu" Header="{DynamicResource Shell.SaveasA}" Click="Save_Click" InputGestureText="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="{DynamicResource Shell.ImportmediaI}" Click="Register_Click" />
        <MenuItem Header="{DynamicResource Shell.Exportvideo}" Click="Export_Click" />
      </MenuItem>
      <MenuItem Header="{DynamicResource Shell.CaptionsT}">
        <MenuItem Header="{DynamicResource Shell.Editcaptions}" Click="EditCaptions_Click" />
        <MenuItem Header="{DynamicResource Shell.ImportSRT}" Click="ImportSrt_Click" />
        <MenuItem Header="{DynamicResource Shell.ExportSRT}" Click="ExportSrt_Click" />
      </MenuItem>
      <MenuItem Header="{DynamicResource Shell.EffectLibrary}" Click="EffectLibrary_Click"/>
      <MenuItem x:Name="EditMenu" Header="{DynamicResource Shell.EditE}">
        <MenuItem x:Name="UndoMenuItem" Header="{DynamicResource Shell.UndoU}" Click="Undo_Click" InputGestureText="Ctrl+Z" />
        <MenuItem x:Name="RedoMenuItem" Header="{DynamicResource Shell.RedoR}" Click="Redo_Click" InputGestureText="Ctrl+Y" />
      </MenuItem>
      <MenuItem Header="{DynamicResource Shell.ClipC}">
        <MenuItem Header="{DynamicResource Shell.SplitatplayheadS}" Click="Split_Click" />
        <MenuItem Header="{DynamicResource Shell.Duplicateselectedclip}" Click="Duplicate_Click" />
        <MenuItem Header="{DynamicResource Shell.DeleteselectedclipD}" Click="Delete_Click" InputGestureText="Delete" />
      </MenuItem>
      <MenuItem x:Name="SequenceMenu" Header="{DynamicResource Shell.SequenceS}"><MenuItem x:Name="AddVideoTrackMenu" Header="{DynamicResource Shell.Addvideotrack}" Tag="Video" Click="AddTrack_Click" /><MenuItem Header="{DynamicResource Shell.Addaudiotrack}" Tag="Audio" Click="AddTrack_Click" /><MenuItem Header="{DynamicResource Shell.Changeduration}" Click="SequenceDuration_Click" /></MenuItem>
      <MenuItem Header="{DynamicResource Shell.ViewV}">
        <MenuItem x:Name="SnappingMenuItem" Header="{DynamicResource Shell.SnappingN}" IsCheckable="True" IsChecked="True" Click="Snapping_Click" />
        <MenuItem Header="{DynamicResource Shell.ZoominI}" Click="ZoomIn_Click" />
        <MenuItem Header="{DynamicResource Shell.ZoomoutO}" Click="ZoomOut_Click" />
      </MenuItem>
      <MenuItem Header="Clapper / Recipe"><MenuItem Header="{DynamicResource Shell.EditnamedrangesandRecipes}" Click="Authoring_Click" /></MenuItem>
      <MenuItem x:Name="McpMenu" Header="MCP / AI" />
      <MenuItem Header="{DynamicResource Shell.Language}">
        <MenuItem x:Name="JapaneseMenu" Header="日本語" IsCheckable="True" IsChecked="True" Tag="ja" Click="Language_Click"/>
        <MenuItem x:Name="EnglishMenu" Header="English" IsCheckable="True" Tag="en" Click="Language_Click"/>
      </MenuItem>
      <MenuItem Header="{DynamicResource Shell.HelpH}" />
    </Menu>
    <ToolBarTray DockPanel.Dock="Top" IsLocked="True" Background="#F6F3F1">
      <ToolBar Background="#F6F3F1" BorderBrush="#D8D3D0" BorderThickness="0,0,0,1">
        <Button Content="📂" Click="Open_Click" Style="{StaticResource CommandIconButton}" ToolTip="{DynamicResource Shell.OpenprojectCtrlO}" />
        <Button x:Name="SaveButton" Content="▣" Click="Save_Click" Style="{StaticResource CommandIconButton}" ToolTip="{DynamicResource Shell.SaveasCtrlShiftS}" />
        <Separator />
        <Button x:Name="UndoButton" Content="↶" Click="Undo_Click" Style="{StaticResource CommandIconButton}" ToolTip="{DynamicResource Shell.UndoCtrlZ}" />
        <Button x:Name="RedoButton" Content="↷" Click="Redo_Click" Style="{StaticResource CommandIconButton}" ToolTip="{DynamicResource Shell.RedoCtrlY}" />
        <Separator />
        <Button x:Name="PrepareButton" Content="{DynamicResource Shell.Preparepreview}" Click="PreparePreview_Click" ToolTip="{DynamicResource Shell.Preparepreviewwithoutplaying}" />
        <ComboBox x:Name="PreviewQualityBox" Width="68" SelectedIndex="1" SelectionChanged="Quality_Changed" ToolTip="{DynamicResource Shell.Previewquality}">
          <ComboBoxItem Content="Full"/><ComboBoxItem Content="1/2"/><ComboBoxItem Content="1/4"/>
        </ComboBox>
        <Button Content="|◀" Click="PreviousFrame_Click" Style="{StaticResource CommandIconButton}" ToolTip="{DynamicResource Shell.Previousframe}" />
        <Button x:Name="PlayButton" Content="▶" Click="Play_Click" Style="{StaticResource CommandIconButton}" ToolTip="{DynamicResource Shell.PlaypauseSpace}" />
        <Button x:Name="StopButton" Content="■" Click="Stop_Click" Style="{StaticResource CommandIconButton}" ToolTip="{DynamicResource Shell.Stopcancelpreparation}" />
        <Button Content="▶|" Click="NextFrame_Click" Style="{StaticResource CommandIconButton}" ToolTip="{DynamicResource Shell.Nextframe}" />
        <TextBlock Text="{DynamicResource Shell.MonitoringVolume}" VerticalAlignment="Center" Margin="8,0,4,0"/>
        <local:PropertySlider x:Name="MonitoringControl" Width="158" SliderMinimum="0" SliderMaximum="1" NumberMinimum="0" NumberMaximum="1" DisplayFactor="100" Suffix="%" Value="1" EditStarted="Monitoring_Started" EditPreview="Monitoring_Preview" EditCommitted="Monitoring_Committed" EditCancelled="Monitoring_Cancelled" AutomationProperties.Name="{DynamicResource Shell.MonitoringVolume}" ToolTip="{DynamicResource Shell.MonitoringHelp}"/>
        <Separator />
        <StackPanel x:Name="ClipContext" Orientation="Horizontal" Visibility="Collapsed">
          <TextBlock x:Name="ContextClipName" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#D20B3A" Margin="4,0,8,0"/>
          <Button x:Name="SplitButton" Content="✂" Click="Split_Click" Style="{StaticResource CommandIconButton}" ToolTip="{DynamicResource Shell.Splitatplayhead}" />
          <Button Content="{DynamicResource Shell.Duplicate}" Click="Duplicate_Click" />
          <Button Content="{DynamicResource Shell.Delete}" Click="Delete_Click" />
        </StackPanel>
      </ToolBar>
    </ToolBarTray>
    <Border DockPanel.Dock="Bottom" Background="#292B2F" Padding="8,5">
      <DockPanel>
        <ContentControl x:Name="McpStatusPanel" DockPanel.Dock="Right" Margin="16,0,0,0"/>
        <TextBlock x:Name="PlaybackStatus" DockPanel.Dock="Right" Foreground="#E7E7E7" Margin="16,0,0,0"/>
        <TextBlock x:Name="Status" Foreground="#E7E7E7" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <Grid Margin="8">
      <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="6"/><RowDefinition Height="2.4*"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/><ColumnDefinition Width="280"/>
      </Grid.ColumnDefinitions>

      <Border Background="#2B2D31" Padding="8">
        <DockPanel TextElement.Foreground="#E7E7E7">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{DynamicResource Shell.ProjectMedia}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <WrapPanel>
              <Button x:Name="ImportButton" Foreground="#202124" Content="{DynamicResource Shell.ImportMOVWAV}" Click="Register_Click" />
              <Button Foreground="#202124" Content="{DynamicResource Shell.Place}" Click="Insert_Click" ToolTip="{DynamicResource Shell.Placeonacompatibletrackattheplayhead}" />
            </WrapPanel>
            <TextBlock x:Name="MediaGuidance" Foreground="#B5BAC2" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
          <ListBox Background="#202124" Foreground="#E7E7E7" BorderBrush="#484B50" x:Name="MediaList" AllowDrop="True" PreviewDragOver="MediaFiles_DragOver" PreviewDrop="MediaFiles_Drop" Margin="0,8,0,0" SelectionChanged="Media_Changed"
                   PreviewMouseLeftButtonDown="Media_MouseDown" PreviewMouseMove="Media_MouseMove" MouseDoubleClick="Media_DoubleClick" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="3">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" Foreground="#B5BAC2" FontSize="11" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{Binding StateBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

      <Border Grid.Column="2" Background="#202124" Padding="8">
        <Grid>
          <Image x:Name="PreviewImage" Stretch="Uniform" />
          <Viewbox Stretch="Uniform" IsHitTestVisible="False"><Canvas x:Name="ClapperCanvas" Width="1920" Height="1080" /></Viewbox>
          <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
            <TextBlock Text="FLAMORIS Kachinco" Foreground="#E7E7E7" FontSize="20" TextAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock x:Name="WelcomeText" Foreground="#B5BAC2" TextWrapping="Wrap" TextAlignment="Center"/>
            <WrapPanel x:Name="WelcomeSequenceChoices" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,8,0,0">
              <Button Content="{DynamicResource Shell.Landscape}" Click="AddLandscapeSequence_Click"/>
              <Button Content="{DynamicResource Shell.Portrait}" Click="AddPortraitSequence_Click"/>
            </WrapPanel>
            <Button x:Name="WelcomeImport" Content="{DynamicResource Shell.ImportMOVWAV}" Click="Register_Click" Margin="0,12,0,4"/>
            <Button Content="{DynamicResource Shell.Openproject}" Click="Open_Click"/>
          </StackPanel>
          <Border x:Name="PlaybackOverlay" Background="#DE202124" VerticalAlignment="Bottom" Padding="12" Visibility="Collapsed">
            <StackPanel><TextBlock x:Name="PlaybackDetail" Foreground="#E7E7E7" TextWrapping="Wrap"/><ProgressBar x:Name="PlaybackProgress" Height="4" Margin="0,8,0,0" Foreground="#D20B3A"/></StackPanel>
          </Border>
          <TextBlock x:Name="PreviewInfo" Foreground="#B7C4D8" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" />

      <Border Grid.Column="4" Background="#2B2D31" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="#E7E7E7">
          <StackPanel>
            <TextBlock Text="{DynamicResource Shell.Inspector}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock x:Name="InspectorEmpty" Text="{DynamicResource Shell.Selectmediaoraclip}" Foreground="#B5BAC2" TextWrapping="Wrap" />
            <StackPanel x:Name="AssetInspector" Visibility="Collapsed">
              <TextBlock Text="{DynamicResource Shell.Media}" Foreground="#B5BAC2" />
              <TextBlock x:Name="AssetNameText" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Visibility="Collapsed" x:Name="AssetIdText" FontSize="10" Foreground="#B5BAC2" TextWrapping="Wrap" Margin="0,3" />
              <TextBlock x:Name="AssetPathText" TextWrapping="Wrap" Margin="0,4" />
              <TextBlock x:Name="AssetMetadataText" TextWrapping="Wrap" />
              <Button x:Name="RelinkButton" Content="{DynamicResource Shell.Relinkmedia}" Click="Relink_Click" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel x:Name="ClipInspector" Visibility="Collapsed">
              <TextBlock Text="{DynamicResource Shell.Clip}" Foreground="#B5BAC2" />
              <TextBlock x:Name="ClipNameText" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Visibility="Collapsed" x:Name="ClipIdText" FontSize="10" Foreground="#B5BAC2" TextWrapping="Wrap" Margin="0,3,0,8" />
              <CheckBox x:Name="ClipEnabledBox" Content="{DynamicResource Shell.Enabled}" Foreground="#E7E7E7" Click="InspectorChoice_Click" Margin="0,7"/>
              <Expander Header="{DynamicResource Shell.Basic}" Style="{StaticResource InspectorSection}"><StackPanel>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Shell.Startseconds}" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="ClipStartBox" Tag="Start" Style="{StaticResource InspectorNumber}"/></Grid>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Shell.Sourceinseconds}" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="ClipSourceInBox" Tag="Source" Style="{StaticResource InspectorNumber}"/></Grid>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Shell.Durationseconds}" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="ClipDurationBox" Tag="Duration" Style="{StaticResource InspectorNumber}"/></Grid>
              </StackPanel></Expander>
              <Expander x:Name="AppearanceSection" Header="{DynamicResource Shell.Appearance}" Style="{StaticResource InspectorSection}"><StackPanel>
                <ComboBox x:Name="BlendBox" SelectionChanged="InspectorBlend_Changed" Margin="0,3,0,6"/>
                <TextBlock Text="{DynamicResource Shell.Opacity}"/>
                <local:PropertySlider x:Name="OpacityControl" Tag="Opacity" SliderMinimum="0" SliderMaximum="1" NumberMinimum="0" NumberMaximum="1" DisplayFactor="100" Suffix="%" EditStarted="InspectorSlider_Started" EditPreview="InspectorSlider_Preview" EditCommitted="InspectorSlider_Committed" EditCancelled="InspectorSlider_Cancelled" AutomationProperties.Name="{DynamicResource Shell.Opacity}" Margin="0,2,0,6"/>
              </StackPanel></Expander>
              <Expander x:Name="TransformSection" Header="{DynamicResource Shell.Transform}" Style="{StaticResource InspectorSection}"><StackPanel>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Shell.PositionX}" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="TransformXBox" Tag="X" Style="{StaticResource InspectorNumber}"/></Grid>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Shell.PositionY}" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="TransformYBox" Tag="Y" Style="{StaticResource InspectorNumber}"/></Grid>

                <TextBlock Text="{DynamicResource Shell.ScaleX}"/>
                <local:PropertySlider x:Name="ScaleXControl" Tag="ScaleX" SliderMinimum="0.01" SliderMaximum="4" NumberMinimum="5E-324" NumberMaximum="Infinity" DisplayFactor="100" Suffix="%" EditStarted="InspectorSlider_Started" EditPreview="InspectorSlider_Preview" EditCommitted="InspectorSlider_Committed" EditCancelled="InspectorSlider_Cancelled" AutomationProperties.Name="{DynamicResource Shell.ScaleX}" Margin="0,2,0,6"/>
                <TextBlock Text="{DynamicResource Shell.ScaleY}"/>
                <local:PropertySlider x:Name="ScaleYControl" Tag="ScaleY" SliderMinimum="0.01" SliderMaximum="4" NumberMinimum="5E-324" NumberMaximum="Infinity" DisplayFactor="100" Suffix="%" EditStarted="InspectorSlider_Started" EditPreview="InspectorSlider_Preview" EditCommitted="InspectorSlider_Committed" EditCancelled="InspectorSlider_Cancelled" AutomationProperties.Name="{DynamicResource Shell.ScaleY}" Margin="0,2,0,6"/>
                <TextBlock Text="{DynamicResource Shell.Rotation}"/>
                <local:PropertySlider x:Name="RotationControl" Tag="Rotation" SliderMinimum="-180" SliderMaximum="180" NumberMinimum="-Infinity" NumberMaximum="Infinity" DisplayFactor="1" Suffix="°" EditStarted="InspectorSlider_Started" EditPreview="InspectorSlider_Preview" EditCommitted="InspectorSlider_Committed" EditCancelled="InspectorSlider_Cancelled" AutomationProperties.Name="{DynamicResource Shell.Rotation}" Margin="0,2,0,6"/>
                <TextBlock Text="{DynamicResource Shell.PropertyAutomation}" FontWeight="SemiBold" Margin="0,8,0,4"/>
                <ComboBox x:Name="PropertyChoice" SelectionChanged="PropertyChoice_Changed"/>
                <ListBox x:Name="PropertyPoints" DisplayMemberPath="Label" Height="92" SelectionChanged="PropertyPoints_Changed"/>
                <TextBlock Text="{DynamicResource Shell.VolumeTime}"/><TextBox x:Name="PropertyTimeBox" Text="0"/>
                <TextBlock Text="{DynamicResource Shell.PropertyValue}"/><TextBox x:Name="PropertyValueBox" Text="0"/>
                <WrapPanel><Button Content="{DynamicResource Shell.NewPoint}" Click="PropertyPoint_New"/><Button Content="{DynamicResource Shell.Applychanges}" Click="PropertyPoint_Save"/><Button Content="{DynamicResource Shell.DeletePoint}" Click="PropertyPoint_Delete"/></WrapPanel>
              </StackPanel></Expander>
              <Expander x:Name="AudioSection" Header="{DynamicResource Shell.Audio}" Style="{StaticResource InspectorSection}"><StackPanel>
                <TextBlock Text="{DynamicResource Shell.Gain}"/>
                <local:PropertySlider x:Name="GainControl" Tag="Gain" SliderMinimum="0" SliderMaximum="2" NumberMinimum="0" NumberMaximum="16" DisplayFactor="100" Suffix="%" EditStarted="InspectorSlider_Started" EditPreview="InspectorSlider_Preview" EditCommitted="InspectorSlider_Committed" EditCancelled="InspectorSlider_Cancelled" AutomationProperties.Name="{DynamicResource Shell.Gain}" Margin="0,2,0,6"/>
                <CheckBox x:Name="MutedBox" Content="{DynamicResource Shell.Muteaudio}" Foreground="#E7E7E7" Click="InspectorChoice_Click"/>
                <TextBlock Text="{DynamicResource Shell.VolumePoints}" FontWeight="SemiBold" Margin="0,12,0,4"/>
                <TextBlock Text="{DynamicResource Shell.VolumePointsHelp}" Foreground="#B5BAC2" TextWrapping="Wrap" Margin="0,0,0,5"/>
                <ListBox x:Name="VolumePointsList" Height="108" DisplayMemberPath="Label" SelectionChanged="VolumePoints_Changed" Background="#202124" Foreground="#E7E7E7" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource Shell.VolumePoints}"/>
                <WrapPanel Margin="0,4">
                  <Button x:Name="AddVolumePointButton" Content="{DynamicResource Shell.AddVolumePoint}" Click="AddVolumePoint_Click"/>
                  <Button x:Name="DeleteVolumePointButton" Content="{DynamicResource Shell.Delete}" Click="DeleteVolumePoint_Click"/>
                </WrapPanel>
                <Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="{DynamicResource Shell.VolumeTime}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  <TextBox x:Name="VolumeTimeBox" Grid.Column="1" Width="96" TextAlignment="Right" KeyDown="VolumeTime_KeyDown" AutomationProperties.Name="{DynamicResource Shell.VolumeTime}"/>
                  <Button x:Name="VolumeTimeApplyButton" Grid.Column="2" Content="✓" Click="VolumeTimeApply_Click" ToolTip="{DynamicResource Shell.Applychanges}"/>
                </Grid>
                <TextBlock Text="{DynamicResource Shell.VolumeMultiplier}" Margin="0,4,0,0"/>
                <local:PropertySlider x:Name="VolumeValueControl" SliderMinimum="0" SliderMaximum="2" NumberMinimum="0" NumberMaximum="16" DisplayFactor="100" Suffix="%" EditStarted="VolumeValue_Started" EditPreview="VolumeValue_Preview" EditCommitted="VolumeValue_Committed" EditCancelled="VolumeValue_Cancelled" AutomationProperties.Name="{DynamicResource Shell.VolumeMultiplier}" Margin="0,2,0,6"/>
                <WrapPanel>
                  <Button x:Name="FadeInButton" Content="{DynamicResource Shell.FadeIn}" Tag="In" Click="FadeVolume_Click"/>
                  <Button x:Name="FadeOutButton" Content="{DynamicResource Shell.FadeOut}" Tag="Out" Click="FadeVolume_Click"/>
                </WrapPanel>
              </StackPanel></Expander>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" Height="6" HorizontalAlignment="Stretch" />
      <Border Grid.Row="2" Grid.ColumnSpan="5" Background="#202124" BorderBrush="#545B66" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#2B2D31" Padding="8,5">
            <WrapPanel>
              <TextBlock Text="{DynamicResource Shell.Timeline}" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
              <ComboBox x:Name="SequenceList" Width="170" DisplayMemberPath="Name" SelectionChanged="Sequence_Changed" />
              <Button x:Name="AddLandscapeSequenceButton" Content="{DynamicResource Shell.Landscape}" Click="AddLandscapeSequence_Click" ToolTip="{DynamicResource Shell.Addlandscapesequence}"/>
              <Button Content="{DynamicResource Shell.Portrait}" Click="AddPortraitSequence_Click" ToolTip="{DynamicResource Shell.Addportraitsequence}"/>
        <ToggleButton x:Name="SnappingButton" Content="{DynamicResource Shell.Snap}" IsChecked="True" Click="Snapping_Click" />
        <Button Content="−" Click="ZoomOut_Click" ToolTip="{DynamicResource Shell.Zoomtimelineout}" />
        <TextBlock Foreground="#E7E7E7" x:Name="ZoomText" VerticalAlignment="Center" MinWidth="62" TextAlignment="Center" />
        <Button Content="＋" Click="ZoomIn_Click" ToolTip="{DynamicResource Shell.Zoomtimelinein}" />
              <Button Content="{DynamicResource Shell.Fit}" Click="FitTimeline_Click" ToolTip="{DynamicResource Shell.Fitsequence}" />
              <TextBlock x:Name="PlayheadText" Foreground="#D5DAE1" VerticalAlignment="Center" Margin="14,0,0,0" />
            </WrapPanel>
          </Border>
          <local:TimelineSurface x:Name="Timeline" CommandRequested="Timeline_CommandRequested"
                                 ClipSelectionChanged="Timeline_ClipSelectionChanged" MediaPlacementRequested="Timeline_MediaPlacementRequested" PlayheadChanged="Timeline_PlayheadChanged"
                                 InteractionFailed="Timeline_InteractionFailed" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>

