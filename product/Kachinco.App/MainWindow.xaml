<Window x:Class="Kachinco.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FLAMORIS Kachinco" Width="1200" Height="780" MinWidth="850" MinHeight="580"
        Background="#F2F3F5" Closing="Window_Closing">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="ファイル(_F)">
        <MenuItem Header="新規・横長(_L)" Click="NewLandscape_Click" />
        <MenuItem Header="新規・縦長(_P)" Click="NewPortrait_Click" />
        <Separator />
        <MenuItem Header="開く(_O)…" Click="Open_Click" InputGestureText="Ctrl+O" />
        <MenuItem Header="名前を付けて保存(_A)…" Click="Save_Click" InputGestureText="Ctrl+Shift+S" />
      </MenuItem>
      <MenuItem Header="編集(_E)">
        <MenuItem x:Name="UndoMenuItem" Header="元に戻す(_U)" Click="Undo_Click" InputGestureText="Ctrl+Z" />
        <MenuItem x:Name="RedoMenuItem" Header="やり直す(_R)" Click="Redo_Click" InputGestureText="Ctrl+Y" />
      </MenuItem>
      <MenuItem Header="クリップ(_C)">
        <MenuItem Header="選択クリップを削除(_D)" Click="Delete_Click" InputGestureText="Delete" />
      </MenuItem>
      <MenuItem Header="シーケンス(_S)" />
      <MenuItem Header="表示(_V)" />
      <MenuItem Header="ヘルプ(_H)" />
    </Menu>
    <ToolBarTray DockPanel.Dock="Top" Background="#E8E9EC">
      <ToolBar Band="0" BandIndex="0">
        <Button x:Name="UndoButton" Content="↶ 元に戻す" Click="Undo_Click" />
        <Button x:Name="RedoButton" Content="↷ やり直す" Click="Redo_Click" />
        <Separator />
        <Button Content="分割" IsEnabled="False" ToolTip="Phase 1のタイムライン選択時に使用できます" />
        <Separator />
        <Button Content="｜◀" IsEnabled="False" ToolTip="再生はPhase 2で実装します" />
        <Button Content="▶" IsEnabled="False" ToolTip="再生はPhase 2で実装します" />
        <Button Content="■" IsEnabled="False" ToolTip="再生はPhase 2で実装します" />
        <Button Content="▶｜" IsEnabled="False" ToolTip="再生はPhase 2で実装します" />
      </ToolBar>
    </ToolBarTray>
    <Border DockPanel.Dock="Bottom" Background="#E4E6EA" Padding="8,5">
      <TextBlock x:Name="Status" TextWrapping="Wrap" />
    </Border>
    <Grid Margin="12">
      <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="6"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="素材" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Button Content="MOV / WAV を登録" Click="Register_Click" />
            <Button Content="選択素材をタイムラインに追加" Click="Insert_Click" />
          </StackPanel>
          <ListBox x:Name="MediaList" DisplayMemberPath="Name" Margin="0,10,0,0" />
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />
      <Border Grid.Column="2" Background="#171B23" Padding="24">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="プレビュー" Foreground="White" FontSize="22" HorizontalAlignment="Center" />
          <TextBlock x:Name="PreviewInfo" Foreground="#B7C4D8" TextAlignment="Center" TextWrapping="Wrap" Margin="0,20" />
          <TextBlock Text="映像再生・動画書き出しは今後の版で対応予定です。" Foreground="#9CA8BC" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="6" HorizontalAlignment="Stretch" />
      <Border Grid.Row="2" Grid.ColumnSpan="3" Background="White" Padding="12">
        <DockPanel>
          <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="タイムライン" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,15,0" />
            <ComboBox x:Name="SequenceList" Width="230" DisplayMemberPath="Name" SelectionChanged="Sequence_Changed" Margin="3" />
            <Button Content="選択クリップを削除" Click="Delete_Click" />
          </WrapPanel>
          <DataGrid x:Name="TimelineGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
              <DataGridTextColumn Header="トラック" Binding="{Binding TrackName}" Width="160" />
              <DataGridTextColumn Header="素材 / 字幕" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="開始（秒）" Binding="{Binding Start}" Width="120" />
              <DataGridTextColumn Header="長さ（秒）" Binding="{Binding Duration}" Width="120" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
