<Window x:Class="Kachinco.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kachinco.App"
        Title="FLAMORIS Kachinco" Width="1320" Height="820" MinWidth="980" MinHeight="640"
        Background="#202124" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <SolidColorBrush x:Key="FamilyAccent" Color="#D20B3A" />
    <Style x:Key="CommandIconButton" TargetType="Button">
      <Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/>
      <Setter Property="Margin" Value="1"/><Setter Property="Padding" Value="6"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
      <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F0E6E9"/><Setter Property="BorderBrush" Value="{StaticResource FamilyAccent}"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Foreground" Value="#202124"/><Setter Property="Background" Value="#F6F3F1"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#202124"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#202124"/><Setter Property="Padding" Value="8,3"/><Setter Property="Margin" Value="2"/></Style>
    <Style x:Key="PanelText" TargetType="TextBlock"><Setter Property="Foreground" Value="#E7E7E7"/></Style>
  </Window.Resources>
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="ファイル(_F)">
        <MenuItem Header="新規・横長(_L)" Click="NewLandscape_Click" />
        <MenuItem Header="新規・縦長(_P)" Click="NewPortrait_Click" />
        <Separator />
        <MenuItem Header="開く(_O)…" Click="Open_Click" InputGestureText="Ctrl+O" />
        <MenuItem Header="名前を付けて保存(_A)…" Click="Save_Click" InputGestureText="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="素材を読み込む(_I)…" Click="Register_Click" />
        <MenuItem Header="動画を書き出す…" Click="Export_Click" />
      </MenuItem>
      <MenuItem Header="字幕(_T)">
        <MenuItem Header="字幕を編集…" Click="EditCaptions_Click" />
        <MenuItem Header="SRTを読み込む…" Click="ImportSrt_Click" />
        <MenuItem Header="SRTを書き出す…" Click="ExportSrt_Click" />
      </MenuItem>
      <MenuItem Header="編集(_E)">
        <MenuItem x:Name="UndoMenuItem" Header="元に戻す(_U)" Click="Undo_Click" InputGestureText="Ctrl+Z" />
        <MenuItem x:Name="RedoMenuItem" Header="やり直す(_R)" Click="Redo_Click" InputGestureText="Ctrl+Y" />
      </MenuItem>
      <MenuItem Header="クリップ(_C)">
        <MenuItem Header="再生ヘッド位置で分割(_S)" Click="Split_Click" />
        <MenuItem Header="選択クリップを複製" Click="Duplicate_Click" />
        <MenuItem Header="選択クリップを削除(_D)" Click="Delete_Click" InputGestureText="Delete" />
      </MenuItem>
      <MenuItem Header="シーケンス(_S)"><MenuItem Header="映像トラックを追加" Tag="Video" Click="AddTrack_Click" /><MenuItem Header="音声トラックを追加" Tag="Audio" Click="AddTrack_Click" /><MenuItem Header="長さを変更…" Click="SequenceDuration_Click" /></MenuItem>
      <MenuItem Header="表示(_V)">
        <MenuItem x:Name="SnappingMenuItem" Header="スナップ(_N)" IsCheckable="True" IsChecked="True" Click="Snapping_Click" />
        <MenuItem Header="拡大(_I)" Click="ZoomIn_Click" />
        <MenuItem Header="縮小(_O)" Click="ZoomOut_Click" />
      </MenuItem>
      <MenuItem Header="Clapper / Recipe"><MenuItem Header="名前付き範囲とRecipeを編集…" Click="Authoring_Click" /></MenuItem>
      <MenuItem Header="AI接続"><MenuItem Header="MCPを開始 / 停止" Click="Mcp_Click" /></MenuItem>
      <MenuItem Header="ヘルプ(_H)" />
    </Menu>
    <ToolBarTray DockPanel.Dock="Top" IsLocked="True" Background="#F6F3F1">
      <ToolBar Background="#F6F3F1" BorderBrush="#D8D3D0" BorderThickness="0,0,0,1">
        <Button Content="📂" Click="Open_Click" Style="{StaticResource CommandIconButton}" ToolTip="プロジェクトを開く (Ctrl+O)" />
        <Button x:Name="SaveButton" Content="▣" Click="Save_Click" Style="{StaticResource CommandIconButton}" ToolTip="名前を付けて保存 (Ctrl+Shift+S)" />
        <Separator />
        <Button x:Name="UndoButton" Content="↶" Click="Undo_Click" Style="{StaticResource CommandIconButton}" ToolTip="元に戻す (Ctrl+Z)" />
        <Button x:Name="RedoButton" Content="↷" Click="Redo_Click" Style="{StaticResource CommandIconButton}" ToolTip="やり直す (Ctrl+Y)" />
        <Separator />
        <Button x:Name="PrepareButton" Content="プレビュー準備" Click="PreparePreview_Click" ToolTip="再生せずにプレビューを準備" />
        <Button Content="|◀" Click="PreviousFrame_Click" Style="{StaticResource CommandIconButton}" ToolTip="前のフレーム" />
        <Button x:Name="PlayButton" Content="▶" Click="Play_Click" Style="{StaticResource CommandIconButton}" ToolTip="再生 / 一時停止 (Space)" />
        <Button x:Name="StopButton" Content="■" Click="Stop_Click" Style="{StaticResource CommandIconButton}" ToolTip="停止 / 準備をキャンセル" />
        <Button Content="▶|" Click="NextFrame_Click" Style="{StaticResource CommandIconButton}" ToolTip="次のフレーム" />
        <Separator />
        <StackPanel x:Name="ClipContext" Orientation="Horizontal" Visibility="Collapsed">
          <TextBlock x:Name="ContextClipName" MaxWidth="160" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#D20B3A" Margin="4,0,8,0"/>
          <Button x:Name="SplitButton" Content="✂" Click="Split_Click" Style="{StaticResource CommandIconButton}" ToolTip="再生ヘッド位置で分割" />
          <Button Content="複製" Click="Duplicate_Click" />
          <Button Content="削除" Click="Delete_Click" />
        </StackPanel>
      </ToolBar>
    </ToolBarTray>
    <Border DockPanel.Dock="Bottom" Background="#292B2F" Padding="8,5">
      <DockPanel>
        <TextBlock x:Name="PlaybackStatus" DockPanel.Dock="Right" Foreground="#E7E7E7" Margin="16,0,0,0"/>
        <TextBlock x:Name="Status" Foreground="#E7E7E7" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <Grid Margin="8">
      <Grid.RowDefinitions><RowDefinition Height="3*"/><RowDefinition Height="6"/><RowDefinition Height="2.4*"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="270"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/>
        <ColumnDefinition Width="6"/><ColumnDefinition Width="280"/>
      </Grid.ColumnDefinitions>

      <Border Background="#2B2D31" Padding="8">
        <DockPanel TextElement.Foreground="#E7E7E7">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="プロジェクト / 素材" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <WrapPanel>
              <Button x:Name="ImportButton" Foreground="#202124" Content="MOV / WAV を読み込む" Click="Register_Click" />
              <Button Foreground="#202124" Content="配置" Click="Insert_Click" ToolTip="再生ヘッド位置の互換トラックへ配置" />
            </WrapPanel>
            <TextBlock x:Name="MediaGuidance" Foreground="#B5BAC2" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
          <ListBox Background="#202124" Foreground="#E7E7E7" BorderBrush="#484B50" x:Name="MediaList" Margin="0,8,0,0" SelectionChanged="Media_Changed"
                   PreviewMouseLeftButtonDown="Media_MouseDown" PreviewMouseMove="Media_MouseMove" MouseDoubleClick="Media_DoubleClick" HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid Margin="3">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" Foreground="#B5BAC2" FontSize="11" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{Binding StateBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />

      <Border Grid.Column="2" Background="#202124" Padding="8">
        <Grid>
          <Image x:Name="PreviewImage" Stretch="Uniform" />
          <Viewbox Stretch="Uniform" IsHitTestVisible="False"><Canvas x:Name="ClapperCanvas" Width="1920" Height="1080" /></Viewbox>
          <StackPanel x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
            <TextBlock Text="FLAMORIS Kachinco" Foreground="#E7E7E7" FontSize="20" TextAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock x:Name="WelcomeText" Foreground="#B5BAC2" TextWrapping="Wrap" TextAlignment="Center"/>
            <Button x:Name="WelcomeImport" Content="MOV / WAVを読み込む" Click="Register_Click" Margin="0,12,0,4"/>
            <Button Content="プロジェクトを開く…" Click="Open_Click"/>
          </StackPanel>
          <Border x:Name="PlaybackOverlay" Background="#DE202124" VerticalAlignment="Bottom" Padding="12" Visibility="Collapsed">
            <StackPanel><TextBlock x:Name="PlaybackDetail" Foreground="#E7E7E7" TextWrapping="Wrap"/><ProgressBar x:Name="PlaybackProgress" Height="4" Margin="0,8,0,0" Foreground="#D20B3A"/></StackPanel>
          </Border>
          <TextBlock x:Name="PreviewInfo" Foreground="#B7C4D8" TextAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" />
        </Grid>
      </Border>
      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" />

      <Border Grid.Column="4" Background="#2B2D31" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="#E7E7E7">
          <StackPanel>
            <TextBlock Text="インスペクター" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10" />
            <TextBlock x:Name="InspectorEmpty" Text="素材またはクリップを選択してください。" Foreground="#B5BAC2" TextWrapping="Wrap" />
            <StackPanel x:Name="AssetInspector" Visibility="Collapsed">
              <TextBlock Text="素材" Foreground="#B5BAC2" />
              <TextBlock x:Name="AssetNameText" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Visibility="Collapsed" x:Name="AssetIdText" FontSize="10" Foreground="#B5BAC2" TextWrapping="Wrap" Margin="0,3" />
              <TextBlock x:Name="AssetPathText" TextWrapping="Wrap" Margin="0,4" />
              <TextBlock x:Name="AssetMetadataText" TextWrapping="Wrap" />
              <Button x:Name="RelinkButton" Content="素材を再リンク…" Click="Relink_Click" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel x:Name="ClipInspector" Visibility="Collapsed">
              <TextBlock Text="クリップ" Foreground="#B5BAC2" />
              <TextBlock x:Name="ClipNameText" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Visibility="Collapsed" x:Name="ClipIdText" FontSize="10" Foreground="#B5BAC2" TextWrapping="Wrap" Margin="0,3,0,8" />
              <TextBlock Text="開始（秒）" /><TextBox x:Name="ClipStartBox" />
              <TextBlock Text="ソースイン（秒）" Margin="0,6,0,0" /><TextBox x:Name="ClipSourceInBox" />
              <TextBlock Text="長さ（秒）" Margin="0,6,0,0" /><TextBox x:Name="ClipDurationBox" />
              <TextBlock Text="合成" Margin="0,6,0,0" /><ComboBox x:Name="BlendBox" />
              <TextBlock Text="不透明度（0〜1）" /><TextBox x:Name="OpacityBox" />
              <TextBlock Text="位置 X / Y（px）" /><TextBox x:Name="TransformXBox" /><TextBox x:Name="TransformYBox" />
              <TextBlock Text="拡大率 X / Y" /><TextBox x:Name="ScaleXBox" /><TextBox x:Name="ScaleYBox" />
              <TextBlock Text="回転（度）" /><TextBox x:Name="RotationBox" />
              <TextBlock Text="音量（0〜16）" /><TextBox x:Name="GainBox" />
              <CheckBox x:Name="MutedBox" Content="音声をミュート" />
              <CheckBox x:Name="ClipEnabledBox" Content="有効" Margin="0,8,0,0" />
              <Button Content="変更を適用" Click="ApplyInspector_Click" Margin="0,8,0,0" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <GridSplitter Grid.Row="1" Grid.ColumnSpan="5" Height="6" HorizontalAlignment="Stretch" />
      <Border Grid.Row="2" Grid.ColumnSpan="5" Background="#202124" BorderBrush="#545B66" BorderThickness="1">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#2B2D31" Padding="8,5">
            <WrapPanel>
              <TextBlock Text="タイムライン" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
              <ComboBox x:Name="SequenceList" Width="170" DisplayMemberPath="Name" SelectionChanged="Sequence_Changed" />
              <Button Content="＋ 横長" Click="AddLandscapeSequence_Click" ToolTip="横長シーケンスを追加"/>
              <Button Content="＋ 縦長" Click="AddPortraitSequence_Click" ToolTip="縦長シーケンスを追加"/>
        <ToggleButton x:Name="SnappingButton" Content="磁石 スナップ" IsChecked="True" Click="Snapping_Click" />
        <Button Content="−" Click="ZoomOut_Click" ToolTip="タイムラインを縮小" />
        <TextBlock Foreground="#E7E7E7" x:Name="ZoomText" VerticalAlignment="Center" MinWidth="62" TextAlignment="Center" />
        <Button Content="＋" Click="ZoomIn_Click" ToolTip="タイムラインを拡大" />
              <Button Content="全体" Click="FitTimeline_Click" ToolTip="シーケンス全体を表示" />
              <TextBlock x:Name="PlayheadText" Foreground="#D5DAE1" VerticalAlignment="Center" Margin="14,0,0,0" />
            </WrapPanel>
          </Border>
          <local:TimelineSurface x:Name="Timeline" CommandRequested="Timeline_CommandRequested"
                                 ClipSelectionChanged="Timeline_ClipSelectionChanged" MediaPlacementRequested="Timeline_MediaPlacementRequested" PlayheadChanged="Timeline_PlayheadChanged"
                                 InteractionFailed="Timeline_InteractionFailed" />
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
